# Librerías con la versión en la ruta: el contenido de una URL nunca cambia, así que el
# navegador puede guardarlo un año sin volver a pedirlo.
<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType font/woff .woff
</IfModule>
